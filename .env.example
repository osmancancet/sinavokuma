# Bu dosyayı `.env` olarak kopyalayın. `.env` git'e commit EDİLMEZ.
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=sinavokuma
POSTGRES_PASSWORD=sinavokuma
POSTGRES_DB=sinavokuma
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sinavokuma:sinavokuma@localhost:5432/sinavokuma

# --- RabbitMQ ---
RABBITMQ_USER=sinavokuma
RABBITMQ_PASSWORD=sinavokuma
RABBITMQ_URL=amqp://sinavokuma:sinavokuma@localhost:5672/
PAPER_QUEUE=paper_processing_queue

# --- MinIO (S3 uyumlu) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sinavokuma
MINIO_SECRET_KEY=sinavokuma123
MINIO_BUCKET=sinav-kagitlari
MINIO_SECURE=false
PRESIGNED_URL_TTL_SECONDS=900

# --- Güvenlik (SRS §5: Zero Trust) ---
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN: openssl rand -hex 32
JWT_SECRET_KEY=gelistirme-icin-guvensiz-anahtar-uretimde-degistirin
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Core API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Inference servisi (FAZ 2) ---
# mock     -> sahte HTR, model indirmeden tüm boru hattını test etmek için
# qwen_mlx -> Apple Silicon, yerel geliştirme (Metal)
# qwen_cuda-> prod GPU sunucusu
HTR_ENGINE=mock
QWEN_MLX_MODEL=mlx-community/Qwen2.5-VL-3B-Instruct-4bit
