# Bu dosyayı `.env` olarak kopyalayın. `.env` git'e commit EDİLMEZ.
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=sinavokuma
POSTGRES_PASSWORD=sinavokuma
POSTGRES_DB=sinavokuma
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sinavokuma:sinavokuma@localhost:5432/sinavokuma

# --- RabbitMQ ---
RABBITMQ_USER=sinavokuma
RABBITMQ_PASSWORD=sinavokuma
RABBITMQ_URL=amqp://sinavokuma:sinavokuma@localhost:5672/
PAPER_QUEUE=paper_processing_queue

# --- MinIO (S3 uyumlu) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sinavokuma
MINIO_SECRET_KEY=sinavokuma123
MINIO_BUCKET=sinav-kagitlari
MINIO_SECURE=false
PRESIGNED_URL_TTL_SECONDS=900

# --- Güvenlik (SRS §5: Zero Trust) ---
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN: openssl rand -hex 32
JWT_SECRET_KEY=gelistirme-icin-guvensiz-anahtar-uretimde-degistirin
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Core API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Inference servisi (FAZ 2) ---
# Hızlı başlangıç için ikisi de "mock" (model indirmez). Gerçek çalıştırma için
# aşağıdaki gibi ayarlayın. Ölçümle doğrulanmış modeller:
#
#   HTR (el yazısı okuma):  Qwen2.5-VL-3B  — %100 karakter doğruluğu, 2.9 sn/kağıt
#   Puanlama (rubrik):      Qwen2.5-7B     — %71 isabet, deterministik
#                           (14B DENENDİ, DAHA KÖTÜ: %43 + 3x yavaş. Büyük ≠ iyi.)
#
# Yerel geliştirme (Apple Silicon / Metal):
#   HTR_ENGINE=qwen_mlx
#   GRADING_ENGINE=qwen_text_mlx
# Prod GPU sunucusu:
#   HTR_ENGINE=qwen_cuda ; GRADING_ENGINE=qwen_cuda (isabet için 32B+ non-quantized)

HTR_ENGINE=mock
GRADING_ENGINE=mock
QWEN_MLX_MODEL=mlx-community/Qwen2.5-VL-3B-Instruct-4bit
GRADING_MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
